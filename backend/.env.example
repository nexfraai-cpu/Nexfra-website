# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Trust the first proxy hop (Railway/Vercel reverse proxy). 1 in production.
TRUST_PROXY=1

# Supabase — REQUIRED
# Only these two are required. The service key drives all server-side access.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://www.nexfra.in,https://erp.nexfra.in

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# File Uploads
UPLOAD_MAX_SIZE=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf

# Storage Buckets
STORAGE_BUCKET_QUOTATIONS=quotation-pdfs
STORAGE_BUCKET_ATTACHMENTS=attachments
STORAGE_BUCKET_ASSETS=company-assets
