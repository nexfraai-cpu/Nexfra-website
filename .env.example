# Nexfra ERP - Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Application Environment: development | test | production
VITE_APP_ENV=production

# Backend API Base URL (defaults to http://localhost:4000)
VITE_API_URL=https://api.nexfra.in

# Storage Provider: localStorage | api
VITE_STORAGE_PROVIDER=api

# Feature Flags (only respected in development mode)
VITE_ENABLE_QUICK_LOGIN=false
VITE_ENABLE_RESET_DATA=false
VITE_ENABLE_DEMO_ACCOUNTS=false
